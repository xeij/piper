# --- Core ---
DATABASE_URL=postgres://user:pass@localhost:5432/piper
PUBLIC_BASE_URL=https://piper.example.com
LINK_SIGNING_SECRET=change-me-32-bytes-min

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Channel: "sendblue" (iMessage) or "twilio" (SMS) ---
CHANNEL_PROVIDER=sendblue
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+1...
SENDBLUE_WEBHOOK_SECRET=   # any random string; paste the same value as the webhook secret in the Sendblue dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

# --- Google Calendar (optional; Apple Calendar works without it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_...   # $19.99/mo
STRIPE_PRICE_YEARLY=price_...    # $119.88/yr ($9.99/mo)

# --- Economics guardrails ---
MAX_BUBBLES_PER_REPLY=3
MAX_PROACTIVE_PER_DAY=4
FREE_MESSAGES=12   # texts a new number gets before piper asks them to subscribe
PAYWALL_GRACE=3    # extra texts after that before replies become just the checkout link
FREE_PHONES=       # comma-separated +E.164 numbers that are never charged
